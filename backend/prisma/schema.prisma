datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        Int  @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  mobile    String   @unique
  role      Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum Role {
  USER
  ADMIN
  EMPLOYEE
}