datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        Int  @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  mobile    String   @unique
  designation String?
  role      Role @default(USER)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?  @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    jobs Job[]
}


model JobType {
  id        Int      @id @default(autoincrement())
  name      String   @unique  // Full-Time, Part-Time
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    jobs Job[]
} 

model WorkMode {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    jobs Job[]
} 

model ExperienceLevel {
  id        Int      @id @default(autoincrement())
  label     String   @unique   // e.g. "1-3 Years"
  minYears  Int
  maxYears  Int

  status    String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    jobs Job[]
}

model EducationLevel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("education_levels")

    jobs Job[]
}

model Location {
  id        Int      @id @default(autoincrement())
  state     String
  city      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   companies Company[]
     jobs Job[]

  @@unique([state, city])
  @@map("locations")
}


model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")

    jobs Job[]
}


model Company {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  website    String?
  logo       String?
  locationId Int?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location   Location? @relation(fields: [locationId], references: [id])

  jobs Job[]

  @@map("companies")
}


model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String?  @default("general")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobSkills JobSkill[]

  @@map("skills")
}

model Benefit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?  // emoji or icon name
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobBenefits JobBenefit[]

  @@map("benefits")
}

model Job {
  id              Int      @id @default(autoincrement())

  title           String
  description     String

  responsibilities String?
  qualifications  String?

 
  companyId       Int
  categoryId      Int
  jobTypeId       Int
  workModeId      Int
  experienceLevelId Int
  educationLevelId Int?
  locationId      Int
  departmentId    Int?

  
  company         Company         @relation(fields: [companyId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])
  jobType         JobType         @relation(fields: [jobTypeId], references: [id])
  workMode        WorkMode        @relation(fields: [workModeId], references: [id])
  experienceLevel ExperienceLevel @relation(fields: [experienceLevelId], references: [id])
  educationLevel  EducationLevel? @relation(fields: [educationLevelId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])

  
  vacancies       Int      @default(1)
  salaryMin       Int?
  salaryMax       Int?
  currency        String   @default("INR")
  applyDeadline   DateTime?
  status          String   @default("draft")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Many-to-Many
  skills          JobSkill[]
  benefits        JobBenefit[]

  applications    Application[]

  @@index([companyId])
  @@index([categoryId])
  @@index([locationId])
}

model JobSkill {
  jobId   Int
  skillId Int

  job     Job   @relation(fields: [jobId], references: [id])
  skill   Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
}


model JobBenefit {
  jobId     Int
  benefitId Int

  job       Job     @relation(fields: [jobId], references: [id])
  benefit   Benefit @relation(fields: [benefitId], references: [id])

  @@id([jobId, benefitId])
}


model Application {
  id        Int      @id @default(autoincrement())

  jobId     Int
  userId    Int

  resumeUrl String?
  linkedin  String?
  portfolio String?

  motivation      String?
  expectedSalary  String?
  noticePeriod    String? 
  status    String   @default("applied")

  createdAt DateTime @default(now())

  job       Job  @relation(fields: [jobId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}